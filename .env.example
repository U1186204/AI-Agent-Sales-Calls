# Oasis environment. Copy to .env:   cp .env.example .env
# Every value below works for a local demo except ANTHROPIC_API_KEY (until you add one, chat
# replies "the assistant isn't available right now" and offers "Talk to a person"; or set
# OASIS_LLM_STUB=1 for the scripted test assistant). Validated by src/config/env.ts.
# Next.js expands `$NAME` in .env values (even when quoted), so every `$` in
# OWNER_PASSWORD_HASH is written as `\$`. src/config/env.ts accepts escaped and raw forms.

# --- App ---------------------------------------------------------------------
# Public base URL (used in emails and CSRF origin checks).
APP_URL=http://localhost:3000
# debug | info | warn | error | silent
LOG_LEVEL=info
# Set true only behind a trusted reverse proxy that OVERWRITES X-Forwarded-For (and sets
# X-Forwarded-Host/-Proto), and make the app port reachable ONLY through that proxy (otherwise
# a direct client can send its own X-Forwarded-For). With false (default) client-sent
# forwarding headers are ignored:
# per-IP limits use the real TCP peer address (stamped at server start), and CSRF origin
# checks in production accept the APP_URL origin only.
TRUST_PROXY=false

# --- LLM (Anthropic) ------------------------------------------------------------
# Get a key at https://console.anthropic.com. Leave blank to run without the assistant.
ANTHROPIC_API_KEY=
# claude-haiku-4-5 (default, cheapest) | claude-sonnet-5-5 | claude-opus-5-5
OASIS_MODEL=claude-haiku-4-5
# Max tokens per model reply.
OASIS_MAX_OUTPUT_TOKENS=1024
# Max tool-call rounds per user message.
OASIS_MAX_TOOL_ROUNDS=6
# Per-call timeout (ms) and retries (exponential backoff + jitter).
OASIS_LLM_TIMEOUT_MS=30000
OASIS_LLM_MAX_RETRIES=2
# Fault injection for tests: none | llm_timeout | llm_error
OASIS_FAULT=none
# TEST ONLY — never set in a real deployment. 1 = replace the AI with a scripted fake
# (src/agent/stub.ts) so e2e/CI can run chat -> checkout without an API key. Ignored unless
# APP_URL is localhost; logs a loud banner at startup; the trace panel shows "Test mode".
OASIS_LLM_STUB=

# --- Guardrails ----------------------------------------------------------------
# USD spend caps (also set a monthly spend limit in the Anthropic Console as a backstop).
OASIS_SESSION_BUDGET_USD=0.25
OASIS_DAILY_BUDGET_USD=2.00
# Max user messages per conversation.
OASIS_MAX_TURNS=40
# Max characters per user message.
OASIS_MAX_INPUT_CHARS=2000
# Chat messages per IP per 10 minutes; generic API requests per IP per minute.
RATE_LIMIT_IP_PER_10MIN=20
RATE_LIMIT_API_PER_MIN=60
# Order/booking status lookups per IP per 10 minutes (blocks reference enumeration).
RATE_LIMIT_STATUS_PER_10MIN=10
# Checkout review + confirm requests per IP per 10 minutes.
RATE_LIMIT_CHECKOUT_PER_10MIN=30
# Booking-form "Service details" edits per IP per 10 minutes.
RATE_LIMIT_DRAFT_EDIT_PER_10MIN=120
# New "Talk to a person" tickets per IP per hour, and per business per hour (all clients).
RATE_LIMIT_ESCALATION_PER_HOUR=3
RATE_LIMIT_ESCALATION_GLOBAL_PER_HOUR=30

# --- Database ------------------------------------------------------------------
# SQLite file, relative to the project root. The directory is created by `npm run seed`.
DATABASE_URL=file:./.data/oasis.db

# --- Secrets (DEMO ONLY — replace for production) ----------------------------------
# The four values below (OASIS_ENCRYPTION_KEY, OASIS_HMAC_KEY, SESSION_SECRET and the demo
# OWNER_PASSWORD_HASH) are PUBLIC. With NODE_ENV=production and a non-localhost APP_URL the
# server REFUSES TO START while any of them is still the demo value (it logs the variable
# names and exits 1). On localhost it only logs a warning, and the owner dashboard shows a
# banner listing them.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AES-256-GCM key for PII at rest: exactly 32 bytes, base64.
OASIS_ENCRYPTION_KEY=c02vb6ANBtVm42agXXjsinwlKpwNYCsaplT336jGgVs=
# HMAC-SHA256 key for email lookup hashes (>= 32 chars).
OASIS_HMAC_KEY=5+JbULno+xksIUmRKaaCNiC1XoxJo9QrB++Mpt6wHC4=
# Signs the owner session cookie (>= 32 chars).
SESSION_SECRET=dhknrHmQZAIJNjrk4cAMsJDi1yqKFm9TqxBTq8p7Eyw=
# THROWAWAY PUBLIC DEMOS ONLY: true lets a production deployment start with the demo secrets
# above (an error is still logged at every start). Never set this when real data is involved.
OASIS_ALLOW_DEMO_SECRETS=

# --- Owner dashboard ---------------------------------------------------------------
# DEMO ONLY: this hash is for the documented demo password `oasis-demo-2026`.
# Make your own:  npm run owner:hash -- "a long passphrase"   and paste the printed
# OWNER_PASSWORD_HASH=... line here (it is already escaped for .env). In a host dashboard
# (Render, Docker env) use the raw hash, also printed — and do NOT also define it in .env:
# Next.js would expand its `$` signs; the server then stops with "OWNER_PASSWORD_HASH looks
# corrupted" instead of half-starting.
# The dashboard shows a warning banner while the demo hash is in use.
OWNER_USERNAME=owner
OWNER_PASSWORD_HASH=scrypt\$16384\$8\$1\$txjopdnqqlu/GfCHK/cP+Q==\$A5h7cVd27GyLGZ3vNeHnpF8Kf6uwCGnJOQFV1RG5FE0=

# --- Notifications -----------------------------------------------------------------
# Escalations go here.
SUPPORT_EMAIL=support@oasis.example.com
# Sender. onboarding@resend.dev only delivers to your own Resend account email until you
# verify a domain.
EMAIL_FROM=Oasis Demo <onboarding@resend.dev>
# Resend HTTP API key. Blank = mock (console + .data/outbox/).
RESEND_API_KEY=
# Twilio REST credentials for business SMS. Any blank = mock (console + .data/outbox/).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sender number, E.164 (e.g. +15005550006).
TWILIO_FROM=
# Where mock email/SMS are written.
OUTBOX_DIR=.data/outbox

# --- Payments ----------------------------------------------------------------------
# Payment provider for checkout (src/payments). Only `none` exists: orders and bookings are
# confirmed without a charge (Payment{provider:none, status:not_required}). Any other value
# (e.g. stripe) stops the server at start with a "not implemented yet" error.
PAYMENT_PROVIDER=none
